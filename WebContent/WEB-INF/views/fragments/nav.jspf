<%-- 상단 고정 내비게이션. 메인이 아닌 페이지에서는 섹션 링크가 메인의 앵커로 간다. --%>
<c:set var="home" value="${ctx}/"/>
<header class="site-nav">
	<div class="wrap nav-inner">
		<a class="brand" href="${home}">
			<span class="brand-mark"><c:out value="${empty p ? 'P' : fn:substring(p.profile.name, 0, 1)}"/></span>
			<span><c:out value="${empty p ? 'Portfolio' : p.profile.name}"/></span>
		</a>
		<nav class="nav-links" aria-label="섹션">
			<a href="${home}#about">소개</a>
			<a href="${home}#skills">기술</a>
			<a href="${home}#experience">경력</a>
			<a href="${home}#projects">프로젝트</a>
			<a href="${home}#education">학력</a>
			<a href="${home}#contact">연락</a>
		</nav>
		<div class="nav-actions">
			<button id="theme-toggle" class="icon-btn" type="button" aria-label="테마 전환" title="라이트/다크 전환">
				<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
				<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
			</button>
			<button id="nav-menu" class="icon-btn menu-btn" type="button" aria-label="메뉴">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
			</button>
		</div>
	</div>
</header>
